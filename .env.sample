# Optional: full path to the SQLite database for parsing.
# If empty, the app falls back to storage/viewhub_parsing.db.
DB_PATH_PARSING=

# Optional: proxy for parsing. Supported formats:
#   host:port
#   http://user:pass@host:port
#   socks5://host:port
# Leave empty to connect directly.
GOLDAPPLE_PROXY=

# Optional: browser rendering mode. The site runs an anti-bot device check that
# usually REJECTS headless browsers, so leave this empty (auto) in production.
#   1 / true / yes / on  -> force headless (lowest resource usage, likely blocked)
#   0 / false / no / off -> force a regular browser window
#   empty               -> auto:
#                           Linux   -> regular browser if DISPLAY is set, else headless
#                           Windows -> regular browser (no X server needed)
# A value set in your shell takes priority over this file.
GOLDAPPLE_HEADLESS=