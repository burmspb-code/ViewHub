# =====================================================================
# Переменные окружения ViewHub
# Файл .env читается при запуске приложения.
# Приоритет: переменная, заданная в терминале, ВАЖНЕЕ значения из этого файла.
#
# Здесь перечислены ТОЛЬКО общие настройки приложения.
# Настройки отдельных парсеров намеренно вынесены из .env в константы классов
# конфигурации: у проекта несколько парсеров, и часть из них работает через
# API без браузера.
# =====================================================================


# --- Общие настройки ------------------------------------------------------

# Необязательно. Путь к файлу базы данных SQLite.
# Если значение пустое, база хранится рядом с программой: storage/viewhub_parsing.db
DB_PATH_PARSING=


# --- Настройки парсера «Золотое Яблоко» ---------------------------------
#
# Эти настройки НЕ входят в .env намеренно: они объявлены константами в
# классе src/parsers_config/golden_apple_config.py.
#
# Если понадобится переключить режим отрисовки на конкретной машине —
# задайте переменную прямо в терминале, это работает и при пустом .env:
#
#   Linux:    export GOLDAPPLE_HEADLESS=0     # обычное окно браузера
#   Windows:  $env:GOLDAPPLE_HEADLESS="0"
#
# Подробное описание — в README, раздел «Переменные окружения».