# =====================================================================
# Переменные окружения ViewHub
# Файл .env читается при запуске приложения.
# Приоритет: переменная, заданная в терминале, ПРИОРИТЕТНЕЕ значения из этого файла.
# =====================================================================


# --- База данных ----------------------------------------------------------

# Необязательно. Путь к файлу базы данных SQLite.
# Если значение пустое, база хранится рядом с программой: storage/viewhub_parsing.db
DB_PATH_PARSING=


# --- Парсер Золотого Яблока (GoldenAppleParser) ---------------------------
#
# ВАЖНО: все переменные ниже относятся ТОЛЬКО к парсеру Золотого Яблока.
# Они не влияют на CitadelParser и GardarikaParser — у каждого парсера свои настройки.


# Прокси для парсинга. Поддерживаемые форматы:
#   host:port
#   http://user:pass@host:port
#   socks5://host:port
# Оставьте пустым, чтобы подключаться напрямую.
GOLDAPPLE_PROXY=


# Режим отрисовки страниц браузера.
#
# По умолчанию используется headless — без отрисовки. Режим проверен на Windows
# и Linux, проходит проверку сайта и заметно экономнее по ресурсам.
#   1 / true / yes / on  -> без отрисовки (то же, что по умолчанию)
#   0 / false / no / off -> обычное окно браузера (требует DISPLAY, тратит больше ресурсов)
#   пусто                -> без отрисовки
#
# ВНИМАНИЕ: в режиме без отрисовки парсер подменяет User-Agent на Chrome/124
# и добавляет флаг --disable-gpu. Оба параметра ОБЯЗАТЕЛЬНЫ: с настоящей
# версией браузера (Chrome/153) сайт отвечает отказом. Не «исправляйте» их.
GOLDAPPLE_HEADLESS=


# Экспериментальные переключатели для разбора отказов сайта.
# Заполняйте только при диагностике — в обычной работе оставьте пустыми.
#
# GOLDAPPLE_UA — подставить свой User-Agent (указывается значение, а не флаг)
# GOLDAPPLE_DISABLE_GPU — добавить --disable-gpu в любом режиме
# GOLDAPPLE_STEALTH_OFF — отключить маскировку автоматизации
# GOLDAPPLE_NO_CHANNEL — не использовать канал chromium